APP_NAME="Riwi Portal"

ENVIRONMENT=development

FRONTEND_URL=http://localhost:5173

MICROSOFT_CLIENT_ID=

MICROSOFT_CLIENT_SECRET=

MICROSOFT_TENANT_ID=

MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Keep disabled until Riwi configures and confirms the institutional tenant UUID.
ENABLE_MICROSOFT_LOGIN=false

# Moodle mobile web-service login. Do not put a user password or Moodle token here.
MOODLE_BASE_URL=https://moodle.riwi.io
MOODLE_SERVICE=moodle_mobile_app
MOODLE_TIMEOUT_SECONDS=10

# Temporary fallback while Moodle and Microsoft are validated.
ENABLE_LOCAL_LOGIN=true

# Comma-separated domains allowed only for first-time external identity linking.
ALLOWED_IDENTITY_EMAIL_DOMAINS=riwi.io

# Moodle may create/link a User from any syntactically valid email. Microsoft
# continues to require an institutional email when it is enabled.
ALLOW_MOODLE_NONINSTITUTIONAL_EMAIL_LINKING=true

# Persistent Moodle-login throttle: five failed username/IP attempts and thirty
# failed IP attempts during a fifteen-minute window.
MOODLE_LOGIN_PAIR_LIMIT=5
MOODLE_LOGIN_IP_LIMIT=30
MOODLE_LOGIN_WINDOW_MINUTES=15

JWT_SECRET=

JWT_ALGORITHM=RS256

JWT_EXPIRE_MINUTES=60

JWT_KID=orbita-2026-08

# PEM RSA private key, generate with:
#   openssl genrsa -out private.pem 2048
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

# PEM RSA public key, generate with:
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# Comma-separated Orbita accounts promoted to platform admin at startup.
PLATFORM_ADMIN_EMAILS=admin@example.com

# Conexion DB
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:0000/db_postgres
